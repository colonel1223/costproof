# Data is regenerated from code, never committed. `make data` reproduces it exactly
# from the seed in SimConfig, so committing it would only add drift risk.
data/
outputs/
*.duckdb
*.parquet

# Secrets -- watsonx credentials live here and must never be committed.
.env

